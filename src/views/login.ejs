<%- include('includes/head') %> <%- include('includes/nav') %>
<div class="container">
  <div class="row">
    <div class="col-lg-2"></div>
    <div class="col-lg-8 my-3">
      <h1 class="text-center">Login</h1>
      <p class="text-center lead">faca o login</p>

      <%- include('includes/messages') %>

      <div class="row">
        <div class="col-lg">
          <h4>Faca seu login</h4>
          <p>Se nao tem senha preencha</p>
          <form
            class="form-cadastro needs-validation"
            novalidate
            action="/login/register"
            method="post"
          >
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <div class="mb-3">
              <label for="register-email" class="form-label">Email address</label>
              <input
                id="register-email"
                type="email"
                class="form-control"
                name="email"
                autocomplete="email"
                required
              />
            </div>
            <div class="mb-3">
              <label for="register-password" class="form-label">Senha</label>
              <input
                id="register-password"
                type="password"
                class="form-control"
                name="password"
                required
                minlength="3"
                maxlength="50"
              />
            </div>
            <button type="submit" class="btn btn-primary">Criar conta</button>
          </form>
        </div>

        <div class="col-lg">
          <h4>Entrar no sistema</h4>
          <p>Faz login</p>
          <form class="form-login needs-validation" novalidate action="/login/login" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <div class="mb-3">
              <label for="login-email" class="form-label">Email address</label>
              <input id="login-email" type="email" class="form-control" name="email" required />
            </div>
            <div class="mb-3">
              <label for="login-password" class="form-label">Senha</label>
              <input
                id="login-password"
                type="password"
                class="form-control"
                name="password"
                required
                minlength="3"
                maxlength="50"
              />
            </div>
            <button type="submit" class="btn btn-primary">Entrar</button>
          </form>
        </div>
      </div>
    </div>
    <div class="col-lg-2"></div>
  </div>
</div>
<%- include('includes/footer') %>
